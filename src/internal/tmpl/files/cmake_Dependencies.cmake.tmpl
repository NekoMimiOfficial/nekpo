set(NEKPO_DEP_INCLUDES "")
set(NEKPO_DEP_LIBS "")
set(NEKPO_THIRD_PARTY_DIR "${CMAKE_SOURCE_DIR}/third_party")

if(IS_DIRECTORY "${NEKPO_THIRD_PARTY_DIR}")
  file(GLOB NEKPO_DEP_DIRS LIST_DIRECTORIES true CONFIGURE_DEPENDS "${NEKPO_THIRD_PARTY_DIR}/*")
  foreach(dep_dir IN LISTS NEKPO_DEP_DIRS)
    if(IS_DIRECTORY "${dep_dir}")
      get_filename_component(dep_name "${dep_dir}" NAME)
      if(EXISTS "${dep_dir}/CMakeLists.txt")
        add_subdirectory("${dep_dir}" "third_party_build/${dep_name}")
      else()
        if(IS_DIRECTORY "${dep_dir}/include")
          list(APPEND NEKPO_DEP_INCLUDES "${dep_dir}/include")
        else()
          list(APPEND NEKPO_DEP_INCLUDES "${dep_dir}")
        endif()
        file(GLOB dep_libs "${dep_dir}/lib/*.a" "${dep_dir}/lib/*.so")
        list(APPEND NEKPO_DEP_LIBS ${dep_libs})
      endif()
    endif()
  endforeach()
endif()
