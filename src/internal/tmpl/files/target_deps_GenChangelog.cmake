set(NEKPO_CHANGELOG_MD "${CMAKE_SOURCE_DIR}/changelog.md")
set(NEKPO_CHANGELOG_SRC "${CMAKE_BINARY_DIR}/debian/changelog")
file(REMOVE "${NEKPO_CHANGELOG_SRC}")

find_package(Git QUIET)

function(nekpo_git result)
  set(${result} "" PARENT_SCOPE)
  if(NOT GIT_EXECUTABLE)
    return()
  endif()
  execute_process(
    COMMAND "${GIT_EXECUTABLE}" ${ARGN}
    WORKING_DIRECTORY "${CMAKE_SOURCE_DIR}"
    OUTPUT_VARIABLE git_out
    ERROR_QUIET
    RESULT_VARIABLE git_rc
    OUTPUT_STRIP_TRAILING_WHITESPACE)
  if(git_rc EQUAL 0)
    set(${result} "${git_out}" PARENT_SCOPE)
  endif()
endfunction()

function(nekpo_protect var)
  set(text "${${var}}")
  string(REPLACE ";" "<SEMI>" text "${text}")
  string(REPLACE "[" "<LB>" text "${text}")
  string(REPLACE "]" "<RB>" text "${text}")
  set(${var} "${text}" PARENT_SCOPE)
endfunction()

function(nekpo_restore var)
  set(text "${${var}}")
  string(REPLACE "<SEMI>" ";" text "${text}")
  string(REPLACE "<LB>" "[" text "${text}")
  string(REPLACE "<RB>" "]" text "${text}")
  set(${var} "${text}" PARENT_SCOPE)
endfunction()

if(EXISTS "${NEKPO_CHANGELOG_MD}")
  set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${NEKPO_CHANGELOG_MD}")
  file(TIMESTAMP "${NEKPO_CHANGELOG_MD}" NEKPO_MD_DATE "%a, %d %b %Y %H:%M:%S +0000" UTC)
  file(READ "${NEKPO_CHANGELOG_MD}" NEKPO_MD_TEXT)
  string(REPLACE "\r" "" NEKPO_MD_TEXT "${NEKPO_MD_TEXT}")
  nekpo_protect(NEKPO_MD_TEXT)
  string(REPLACE "\n" ";" NEKPO_MD_LINES "${NEKPO_MD_TEXT}")

  set(NEKPO_VERSIONS "")
  set(NEKPO_INDEX -1)
  foreach(line IN LISTS NEKPO_MD_LINES)
    string(STRIP "${line}" line)
    if(line MATCHES "^#+ *[vV]?([0-9][^ ]*)")
      math(EXPR NEKPO_INDEX "${NEKPO_INDEX} + 1")
      list(APPEND NEKPO_VERSIONS "${CMAKE_MATCH_1}")
      set(NEKPO_MD_BULLETS_${NEKPO_INDEX} "")
    elseif(NEKPO_INDEX GREATER_EQUAL 0 AND line MATCHES "^[-*] +(.+)")
      string(APPEND NEKPO_MD_BULLETS_${NEKPO_INDEX} "  * ${CMAKE_MATCH_1}\n")
    endif()
  endforeach()

  list(LENGTH NEKPO_VERSIONS NEKPO_TOTAL)
  if(NEKPO_TOTAL GREATER 0)
    math(EXPR NEKPO_LAST "${NEKPO_TOTAL} - 1")

    foreach(i RANGE ${NEKPO_LAST})
      list(GET NEKPO_VERSIONS ${i} ver)
      set(NEKPO_SHA_${i} "")
      foreach(prefix "v" "")
        if("${NEKPO_SHA_${i}}" STREQUAL "")
          nekpo_git(sha rev-parse -q --verify "refs/tags/${prefix}${ver}^{commit}")
          set(NEKPO_SHA_${i} "${sha}")
        endif()
      endforeach()
    endforeach()

    set(NEKPO_DEB_CHANGELOG "")
    foreach(i RANGE ${NEKPO_LAST})
      list(GET NEKPO_VERSIONS ${i} ver)
      set(sha "${NEKPO_SHA_${i}}")
      set(bullets "${NEKPO_MD_BULLETS_${i}}")
      set(date "${NEKPO_MD_DATE}")

      if(NOT "${sha}" STREQUAL "")
        nekpo_git(commit_date log -1 "--format=%cD" "${sha}")
        if(NOT "${commit_date}" STREQUAL "")
          set(date "${commit_date}")
        endif()

        math(EXPR older "${i} + 1")
        set(range "${sha}")
        set(use_git TRUE)
        if(older LESS NEKPO_TOTAL)
          if("${NEKPO_SHA_${older}}" STREQUAL "")
            set(use_git FALSE)
          else()
            set(range "${NEKPO_SHA_${older}}..${sha}")
          endif()
        endif()

        if(use_git)
          nekpo_git(subjects log --no-merges "--format=%s" "${range}")
          nekpo_protect(subjects)
          if(NOT "${subjects}" STREQUAL "")
            set(bullets "")
            string(REPLACE "\n" ";" subject_list "${subjects}")
            foreach(subject IN LISTS subject_list)
              string(STRIP "${subject}" subject)
              if(NOT "${subject}" STREQUAL "")
                string(APPEND bullets "  * ${subject}\n")
              endif()
            endforeach()
          endif()
        endif()
      endif()

      if("${bullets}" STREQUAL "")
        set(bullets "  * Release ${ver}.\n")
      endif()
      string(APPEND NEKPO_DEB_CHANGELOG "@ID@ (${ver}) unstable; urgency=medium\n\n${bullets}\n -- ${NEKPO_MAINTAINER}  ${date}\n\n")
    endforeach()

    nekpo_restore(NEKPO_DEB_CHANGELOG)
    string(STRIP "${NEKPO_DEB_CHANGELOG}" NEKPO_DEB_CHANGELOG)
    file(WRITE "${NEKPO_CHANGELOG_SRC}" "${NEKPO_DEB_CHANGELOG}\n")
  endif()
endif()
